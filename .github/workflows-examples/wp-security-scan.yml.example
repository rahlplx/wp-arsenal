# Example GitHub Actions workflow — scheduled WordPress security scan.
#
# Copy this file to .github/workflows/wp-security-scan.yml in the repo where
# you keep your WP-Arsenal config (NOT this toolkit repo — your own private
# ops repo, since it will reference your site's secrets).
#
# Required GitHub Secrets:
#   WP_SSH_HOST, WP_SSH_USER, WP_SSH_PASSWORD, WP_PATH
#   WP_DB_HOST, WP_DB_USER, WP_DB_PASS, WP_DB_NAME
#   WP_SITE_URL, ALERT_EMAIL
#   SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD

name: WP-Arsenal Scheduled Security Scan

on:
  schedule:
    - cron: "0 6 * * *"   # daily at 06:00 UTC
  workflow_dispatch: {}     # allow manual trigger from the Actions tab

jobs:
  scan:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout wp-arsenal
        uses: actions/checkout@v4
        with:
          repository: rahlplx/wp-arsenal
          path: wp-arsenal

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: pip install -r wp-arsenal/requirements.txt

      - name: Run wp-scan
        working-directory: wp-arsenal
        run: |
          python scripts/security/wp-scan.py \
            --host "${{ secrets.WP_SSH_HOST }}" \
            --user "${{ secrets.WP_SSH_USER }}" \
            --password "${{ secrets.WP_SSH_PASSWORD }}" \
            --wp-path "${{ secrets.WP_PATH }}" \
            --db-host "${{ secrets.WP_DB_HOST }}" \
            --db-user "${{ secrets.WP_DB_USER }}" \
            --db-pass "${{ secrets.WP_DB_PASS }}" \
            --db-name "${{ secrets.WP_DB_NAME }}" \
            --site-url "${{ secrets.WP_SITE_URL }}" \
            --json > logs/wp-scan.json

      - name: Run wp-theme-audit
        working-directory: wp-arsenal
        run: |
          python scripts/security/wp-theme-audit.py \
            --host "${{ secrets.WP_SSH_HOST }}" \
            --user "${{ secrets.WP_SSH_USER }}" \
            --password "${{ secrets.WP_SSH_PASSWORD }}" \
            --wp-path "${{ secrets.WP_PATH }}" \
            --db-host "${{ secrets.WP_DB_HOST }}" \
            --db-user "${{ secrets.WP_DB_USER }}" \
            --db-pass "${{ secrets.WP_DB_PASS }}" \
            --db-name "${{ secrets.WP_DB_NAME }}" \
            --json > logs/wp-theme-audit.json

      - name: Run wp-woo-audit
        working-directory: wp-arsenal
        run: |
          python scripts/security/wp-woo-audit.py \
            --host "${{ secrets.WP_SSH_HOST }}" \
            --user "${{ secrets.WP_SSH_USER }}" \
            --password "${{ secrets.WP_SSH_PASSWORD }}" \
            --wp-path "${{ secrets.WP_PATH }}" \
            --db-host "${{ secrets.WP_DB_HOST }}" \
            --db-user "${{ secrets.WP_DB_USER }}" \
            --db-pass "${{ secrets.WP_DB_PASS }}" \
            --db-name "${{ secrets.WP_DB_NAME }}" \
            --json > logs/wp-woo-audit.json

      - name: Send digest email if anything found
        working-directory: wp-arsenal
        env:
          SMTP_HOST: ${{ secrets.SMTP_HOST }}
          SMTP_PORT: ${{ secrets.SMTP_PORT }}
          SMTP_USER: ${{ secrets.SMTP_USER }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
        run: |
          python scripts/management/wp-digest.py \
            --logs-dir logs/ \
            --hours 24 \
            --min-severity MEDIUM \
            --smtp-host "$SMTP_HOST" --smtp-port "$SMTP_PORT" \
            --smtp-user "$SMTP_USER" --smtp-password "$SMTP_PASSWORD" \
            --to "${{ secrets.ALERT_EMAIL }}"

      - name: Upload scan artifacts
        uses: actions/upload-artifact@v4
        with:
          name: wp-arsenal-scan-logs-${{ github.run_id }}
          path: wp-arsenal/logs/*.json
          retention-days: 30
